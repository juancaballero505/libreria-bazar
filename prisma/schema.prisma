generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("customer") // admin | customer
  createdAt DateTime @default(now())
  orders    Order[]
}

model Category {
  id       String    @id @default(cuid())
  name     String
  products Product[]
}

model Product {
  id          String      @id @default(cuid())
  name        String
  description String?
  sku         String      @unique
  price       Float
  stock       Int         @default(0)
  reserved    Int         @default(0)
  minStock    Int         @default(5)
  imageUrl    String?
  categoryId  String?
  category    Category?   @relation(fields: [categoryId], references: [id])
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  orderItems  OrderItem[]
  promotions PromotionProduct[]
}

model Promotion {
  id         String    @id @default(cuid())
  name       String
  porcentaje Int       // entero entre 1 y 50, validado en el servidor
  startDate  DateTime
  endDate    DateTime
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())
  productos  PromotionProduct[]
}

model PromotionProduct {
  id          String    @id @default(cuid())
  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id])
  productId   String
  product     Product   @relation(fields: [productId], references: [id])

  @@unique([promotionId, productId])
}

model Order {
  id             String      @id @default(cuid())
  userId         String?
  user           User?       @relation(fields: [userId], references: [id])
  status         String      @default("pending") // pending | paid | delivered | cancelled | refunded
  deliveredAt    DateTime?
  total          Float
  discount       Float       @default(0)
  mpPreferenceId String?
  mpPaymentId    String?
  customerName   String?
  customerEmail  String?
  customerPhone  String?
  createdAt      DateTime    @default(now())
  items          OrderItem[]   
  printJobs      PrintJob[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float   // precio al momento de la venta
  refunds   Refund[]
}

model PrintJob {
  id           String    @id @default(cuid())
  orderId      String?
  order        Order?    @relation(fields: [orderId], references: [id])
  originalName String
  storagePath  String
  pages        Int
  copies       Int       @default(1)
  color        Boolean   @default(false)
  duplex       Boolean   @default(false)
  paper        String    @default("a4") // a4 | foto
  price        Float
  status       String    @default("pendiente") // pendiente | impreso | listo | entregado
  createdAt    DateTime  @default(now())
  dueAt        DateTime?
  printedAt    DateTime?
}

model Refund {
  id          String    @id @default(cuid())
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])
  quantity    Int
  amount      Float
  reason      String?
  status      String    @default("pending") // pending | approved | failed
  mpRefundId  String?
  createdAt   DateTime  @default(now())
}

